# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# Your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Path to the Pathway Portal SQLite database file, using the sqlite:/// scheme.
# Use 4 slashes for an absolute path, 3 for a relative path.
DATABASE_URL=sqlite:////absolute/path/to/pathway_portal.db
